		},
		{
			"id": "touwUIFalnae02BUl",
			"name": "気温の変化に強い (Temperature Tolerance)",
			"reference": "B93",
			"local_notes": "<script>\nif (entity.exists) {\n  var degreesHotter = 0;\n  var degreesColder = 0;\n  const hotMod = self.findActiveModifier(\"暑さ (Hot)\");\n  const coldMod = self.findActiveModifier(\"寒冷 (Cold)\");\n  const degreesHotterMod = self.findActiveModifier(\"暑い側の度数 (Degrees Hotter)\");\n  const degreesColderMod = self.findActiveModifier(\"寒い側の度数 (Degrees Colder)\");\n  if (hotMod) {\n    degreesHotter = $ht * self.level;\n  }\n  if (coldMod) {\n    degreesColder = $ht *self.level;\n  } \n  if (degreesHotterMod) {\n    degreesHotter = degreesHotterMod.level;\n  }\n  if (degreesColderMod) {\n    degreesColder = degreesColderMod.level;\n  }\n  if (degreesHotter == 0 && degreesColder == 0) {\n    degreesHotter = $ht *self.level / 2;\n    degreesColder = $ht *self.level / 2;\n  }\n  var strings = [];\n  if (degreesHotter != 0) {\n    strings.push(degreesHotter + \"°高温側\");\n  }\n  if (degreesColder != 0) {\n    strings.push(degreesColder +\"°低温側\");;\n  }\n  strings.join(\"、\")\n} else {\n  \"キャラクターシートに追加されたときに、快適温度域がどれだけ広がるかが計算されます\"\n}\n</script>",
			"tags": [
				"Advantage",
				"Physical"
			],
			"prereqs": {
				"type": "prereq_list",
				"all": true,
				"prereqs": [
					{
						"type": "script_prereq",
						"script": "var msgs = [];\nvar modifierCount = 0;\nconst hotMod = self.findActiveModifier(\"暑さ (Hot)\");\nconst coldMod = self.findActiveModifier(\"寒冷 (Cold)\");\nconst degreesHotterMod = self.findActiveModifier(\"暑い側の度数 (Degrees Hotter)\");\nconst degreesColderMod = self.findActiveModifier(\"寒い側の度数 (Degrees Colder)\");\nif (hotMod) {\n  modifierCount++;\n}\nif (coldMod) {\n  modifierCount++;\n}\nif (degreesHotterMod || degreesColderMod) {\n  modifierCount++;\n}\nif (modifierCount > 1) {\n  msgs.push(\"「暑さ」「寒冷」「暑い側/寒い側の度数」は混在させられません\")\n}\nif (entity.exists) {\n  const expectedLevels = $ht * self.level;\n  var foundLevels = 0;\n  if (degreesHotterMod) {\n    foundLevels += degreesHotterMod.level;\n  }\n  if (degreesColderMod) {\n    foundLevels += degreesColderMod.level;\n  }\n  if (foundLevels != 0 && expectedLevels != foundLevels) {\n    msgs.push(`「暑い側の度数」と「寒い側の度数」のレベル合計は ${foundLevels} ではなく ${expectedLevels} でなければなりません`)\n  }\n}\nmsgs.join(\"\\n* \")"
					}
				]
			},
			"modifiers": [
				{
					"id": "MI1VcdSeblizJBfA0",
					"name": "キャラクターの快適温度域に度数をどう割り振るか選択 (Choose how to distribute degrees to the character's comfort zone)",
					"reference": "B93",
					"reference_highlight": "Each level of Temperature Tolerance adds HT degrees to your comfort zone, distributed in any way you wish between the “cold” and “hot” ends of the zone.",
					"local_notes": "「寒冷」は、すべてを寒い気温への耐性に回す。「暑さ」は、すべてを暑い気温への耐性に回す。「暑い側の度数」と「寒い側の度数」は、気温の範囲を広げる度数を手動で割り振る。どれも選ばなければ、度数は均等に配分される",
					"children": [
						{
							"id": "mvjyobEJOxYbZW4m6",
							"name": "暑さ (Hot)",
							"disabled": true
						},
						{
							"id": "mPS-5mvnutZR3JDmq",
							"name": "寒冷 (Cold)",
							"disabled": true
						},
						{
							"id": "mHi-iuFBpG3_YxV-6",
							"name": "暑い側の度数 (Degrees Hotter)",
							"levels": 1,
							"disabled": true
						},
						{
							"id": "m8AT5TarZDUhOwxBf",
							"name": "寒い側の度数 (Degrees Colder)",
							"levels": 1,
							"disabled": true
						}
					]
				}
			],
			"points_per_level": 1,
			"can_level": true,
			"levels": 1,
			"calc": {
				"points": 1,
				"resolved_notes": "キャラクターシートに追加されたときに、快適温度域がどれだけ広がるかが計算されます",
				"level": 1,
				"current_level": 1
			}
		},
